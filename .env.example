# telegram-ai-cli — example environment file.
#
# Copy to .env and fill in real values. This file must never contain a real
# secret, phone number, api_hash, chat id or session material — it's committed
# to a public repository. Settings are loaded via pydantic-settings with the
# TGAI_ prefix and "__" as the nesting separator (see telegram_ai_cli/config.py);
# everything below can also be set in the YAML config file instead.

# --- Profile -----------------------------------------------------------------
# readonly (default): only the read tools/commands work.
# plan: read, plus creating plans. Nothing is ever sent without a separate
# `tg-ai plan apply` — there is no profile that sends directly.
TGAI_PROFILE=readonly

# --- Fallback Telegram app credentials ---------------------------------------
# From https://my.telegram.org — only used when an account has no fingerprint
# of its own frozen next to its session. Placeholders only.
TGAI_API_ID=00000000
TGAI_API_HASH=your_api_hash_here

# --- Secrets at rest -----------------------------------------------------------
# Encrypts api_hash, proxy credentials and (optionally) plan bodies at rest.
# Generate with:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Leave unset to let the tool generate and store a key file itself (0600).
TGAI_SECRET_KEY=

# --- Paths ---------------------------------------------------------------------
# Defaults live under $XDG_STATE_HOME/telegram-ai-cli (or ~/.local/state/...).
# Override only if you need a non-default layout, e.g. inside a container.
# TGAI_PATHS__SESSIONS=/path/to/sessions
# TGAI_PATHS__STATE=/path/to/state
# TGAI_PATHS__DOWNLOADS=/path/to/downloads
# TGAI_PATHS__AUDIT_LOG=/path/to/audit.jsonl

# --- Config file location -------------------------------------------------------
# Default: ~/.config/telegram-ai-cli/tgai.yaml
# TGAI_CONFIG=/path/to/tgai.yaml

# --- MCP tool visibility -------------------------------------------------------
# Which tools the MCP server publishes. Unset (the default) publishes every one
# of them; set, only these are published — in the tool list and on the call
# path, so a tool left out is one a prompt injection never sees and cannot
# invoke by name. JSON list, like every other list-valued setting. A name this
# server does not publish is a startup error, not a silently dropped entry.
# TGAI_MCP__TOOLS=["telegram_chats","telegram_chat_read","telegram_search"]

# --- Safety: example allowlist entries (placeholders, not real chat ids) -------
# TGAI_SAFETY__READ__DMS__ALLOW=["123456789"]
# TGAI_SAFETY__WRITE__SEND__ALLOW=["123456789","-1001234567890"]

# --- Proxy credentials ------------------------------------------------------
# Proxy configuration is per account (parsed and stored per session, not a
# single global setting), set when the account is added rather than through
# this file: `tg-ai account add --proxy ...` / `tg-ai account login --proxy ...`.
# See `tg-ai account add --help` and docs/configuration.md.
